<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    
    <Authors>Teste Livro Refactoring with C#</Authors>
    <Company>Company I</Company>
    <PackageId>CompanyAnalyzers</PackageId>
    <PackageVersion>1.0.0</PackageVersion>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>
      Sample analyzer with fix from "Refactoring with C#"
      by Matt Eland via Packt Publishing.
    </Description>
    <PackageProjectUrl>
      https://github.com/thsdias/livro-refactoring-with-csharp
    </PackageProjectUrl>
    <RepositoryUrl>
      https://github.com/thsdias/livro-refactoring-with-csharp
    </RepositoryUrl>
    
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis" Version="4.0.1" />
    <None Include="$(OutputPath)\Packt.Analyzers.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
  </ItemGroup>
</Project>

<!-- 
 - GeneratePackageOnBuild: é o mesmo que marcar a caixa na página de propriedades para compilar o pacote na compilação.
 - IncludeBuildOutput: diz ao processo de empacotamento para não incluir os resultados da compilação no pacote gerado. Em vez disso, faremos algo diferente para incluir esses arquivos usando a seção.ItemGroup
 - PackageId: é um identificador exclusivo para seu pacote NuGet. Embora o código neste livro use Packt.Analyzers, recomendo usar seu nome sem espaços ou pontuação no lugar de Packtpara evitar conflitos ao publicar isso.
 - PackageVersion: é o número da versão de lançamento do seu pacote. A versão mais recente de um pacote é normalmente o que as pessoas instalam usando o NuGet.
 - PackageLicenseExpression: é opcional, mas permite que você diga aos outros qual licença de código aberto, se houver, se aplica ao uso do seu pacote. Os vários tipos de licença e suas implicações legais estão além do escopo deste livro.
 - Description: é uma breve descrição amigável do que o pacote faz e por que alguém pode querer instalá-lo.
 - RepositoryUrl: é opcional e informa aos outros onde o código do pacote está disponível.
-->
